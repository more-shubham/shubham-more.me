# AWS Infrastructure Configuration Example
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_S3_BUCKET=your-bucket-name
AWS_CLOUDFRONT_DISTRIBUTION_ID=YOUR_CLOUDFRONT_DISTRIBUTION_ID
AWS_API_GATEWAY_ID=your_api_gateway_id
AWS_API_GATEWAY_ENDPOINT=https://your_api_gateway_id.execute-api.us-east-1.amazonaws.com/prod
AWS_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/your-role-name
AWS_LAMBDA_ROLE_NAME=your-role-name
